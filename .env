# =========================================================
# IKA — backend connection
# ---------------------------------------------------------
# For local development, use the Vite dev proxy so the browser
# calls the same-origin /api endpoint and Vite forwards it to
# your backend on localhost:8080.
#
# IMPORTANT: leave VITE_API_BASE_URL empty in local dev and set
# VITE_DEV_PROXY to your backend host. The app already adds
# /api/v1/... to each request path.
#
# ⚠️  After editing this file you MUST restart `npm run dev`
#     (Vite reads .env only at startup).
# =========================================================

VITE_API_BASE_URL=
VITE_DEV_PROXY=http://localhost:8080

# =========================================================
# MOCK MODE — run the whole app off src/mock/data.json
# ---------------------------------------------------------
# true  → every REST call is served from the fixture (no backend
#         needed). Anything the fixture does not cover falls
#         through to the real API, so a partial fixture degrades
#         instead of blanking the screen.
# false → normal operation, real database. (default)
#
# Per-device override, no rebuild needed — in the browser console:
#   localStorage.ika_mock = 'on'    // force fixtures
#   localStorage.ika_mock = 'off'   // force the real API
#   localStorage.removeItem('ika_mock')  // back to this flag
#
# ⚠️  Restart `npm run dev` after changing anything here.
# =========================================================
VITE_USE_MOCK=true

# Which language the fixture renders in: en | ar | ku | tr
# (override live with localStorage.ika_mock_lang = 'ar')
VITE_MOCK_LANG=en

# Fake latency in ms, so loading and skeleton states stay visible
# while demoing. 0 disables it.
VITE_MOCK_DELAY_MS=220
